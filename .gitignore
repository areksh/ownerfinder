/proposals/
/apps/web/public/data/
/apps/web/test-results/
/apps/web/playwright-report/
/apps/*/dist/
/packages/*/build/
/proposals/
/apps/web/public/data/
/apps/web/test-results/
/apps/web/playwright-report/
/packages/*/dist/
/build/
/proposals/
/apps/web/public/data/
/apps/web/test-results/
/apps/web/playwright-report/
coverage/

# Cloudflare and React Router local state and generated types
.wrangler/
.react-router/
worker-configuration.d.ts

# Secrets and local environment
.env*
.dev.vars*

# Logs, OS and editor cruft
*.log
.DS_Store
.vscode/
.idea/
*.tsbuildinfo
