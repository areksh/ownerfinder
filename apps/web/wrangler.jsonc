{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecf-web",
  "compatibility_date": "2026-11-07",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // The API Worker, reached without leaving Cloudflare (docs/website.md).
  "services": [{ "binding": "API", "service": "ecf-api" }],
  // The request form (docs/website.md). It stays closed until the site key
  // here and the secrets TURNSTILE_SECRET_KEY and GITHUB_TOKEN are set.
  "vars": { "GITHUB_REPO": "areksh/ownerfinder", "TURNSTILE_SITE_KEY": "" }
}
