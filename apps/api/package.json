{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply ecf-graph --remote",
    "db:load": "wrangler d1 execute ecf-graph --remote --yes --file ../../build/graph.sql",
    "db:migrate:local": "wrangler d1 migrations apply ecf-graph --local",
    "db:load:local": "wrangler d1 execute ecf-graph --local --yes --file ../../build/graph.sql"
  },
  "dependencies": {
    "@ecf/model": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@ecf/data": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-istanbul": "5.1.0",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
